<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Critical_Request_Description</fullName>
    <active>true</active>
    <description>When the priority is Critical, Description is required</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Priority__c, &quot;Critical&quot;),
    ISBLANK(Description__c)
    )</errorConditionFormula>
    <errorDisplayField>Description__c</errorDisplayField>
    <errorMessage>Description is required for Critical requests.</errorMessage>
</ValidationRule>
